<Window x:Class="QQMusicLyrics.UI.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ音乐浮窗歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root">
        <!-- 可选背景板：给纯白歌词垫一层深色底，在亮色画面上更易读 -->
        <Border x:Name="Backdrop"
                CornerRadius="10"
                Background="#FF000000"
                Opacity="0.30" />

        <!-- 单行歌词（需要翻译时是它下面的一小行） -->
        <StackPanel x:Name="ContentPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="16,4,16,4">

            <TextBlock x:Name="CurrentLine"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="White"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Bold"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="CurrentLineOffset" X="0" Y="0" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TranslationLine"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#D8A8E6FF"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Normal"
                       Margin="0,2,0,0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- 临时状态文字：正在匹配歌词 / 未找到歌词 -->
        <TextBlock x:Name="StatusLine"
                   TextAlignment="Center"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16,0"
                   Foreground="#C8FFFFFF"
                   FontFamily="Microsoft YaHei UI"
                   FontWeight="SemiBold"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
