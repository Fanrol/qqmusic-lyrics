<Window x:Class="QQMusicLyrics.UI.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ音乐浮窗歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root">
        <!-- 可选背景板：给纯白歌词垫一层深色底，在亮色游戏画面上更易读 -->
        <Border x:Name="Backdrop"
                CornerRadius="16"
                Background="#FF000000"
                Opacity="0.28" />

        <!-- 歌词主体：上一行 / 当前行 / 翻译 / 下一行 -->
        <StackPanel x:Name="LyricsPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="30,10,30,10">

            <TextBlock x:Name="PrevLine"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#B0FFFFFF"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="SemiBold"
                       Margin="0,0,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="9" ShadowDepth="0" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="CurrentLine"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="White"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Bold"
                       Margin="0,2,0,2"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.95" />
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="CurrentLineOffset" X="0" Y="0" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TranslationLine"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#D8A8E6FF"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Normal"
                       Margin="0,1,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="9" ShadowDepth="0" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="NextLine"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#B0FFFFFF"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="SemiBold"
                       Margin="0,2,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="9" ShadowDepth="0" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- 无歌词 / 等待播放时显示的状态文字 -->
        <TextBlock x:Name="StatusLine"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="30,0"
                   Foreground="#C8FFFFFF"
                   FontFamily="Microsoft YaHei UI"
                   FontWeight="SemiBold"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="9" ShadowDepth="0" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
