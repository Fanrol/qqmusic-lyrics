<Window x:Class="QQMusicLyrics.UI.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ音乐浮窗歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!-- 固定高度：按钮出现/消失时歌词不会上下跳 -->
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 三个按钮：锁 · 加 · 减，整组居中；鼠标移入浮窗才淡入，移开 1 秒后淡出 -->
        <StackPanel x:Name="ButtonBar"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,6,0,0"
                    Opacity="0">

            <Border x:Name="LockButton"
                    Width="24" Height="24"
                    Margin="0,0,14,0"
                    Background="Transparent"
                    Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
                <Viewbox Stretch="Uniform">
                    <!-- 24x24 设计坐标，与 Glyphs 的 GDI+ 版本保持一致 -->
                    <Canvas Width="24" Height="24">
                        <Rectangle x:Name="LockBody"
                                   Canvas.Left="5" Canvas.Top="11" Width="14" Height="10"
                                   RadiusX="2.5" RadiusY="2.5"
                                   Stroke="White" StrokeThickness="1.6" />

                        <!-- 开着的锁：只扫 130°，右侧留明显缺口 -->
                        <Path x:Name="LockShackleOpen"
                              Stroke="White" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 8.5,11 L 8.5,7.5 A 3.5,3.5 0 0 1 14.25,4.82" />

                        <!-- 关着的锁：扫 180° + 右腿落回锁体 -->
                        <Path x:Name="LockShackleClosed"
                              Stroke="White" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 8.5,11 L 8.5,7.5 A 3.5,3.5 0 0 1 15.5,7.5 L 15.5,11"
                              Visibility="Collapsed" />
                    </Canvas>
                </Viewbox>
            </Border>

            <Border x:Name="PlusButton"
                    Width="24" Height="24"
                    Margin="0,0,6,0"
                    Background="Transparent"
                    Cursor="Hand"
                    Visibility="Hidden">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 6,13 L 18,13 M 12,7 L 12,19" />
                    </Canvas>
                </Viewbox>
            </Border>

            <Border x:Name="MinusButton"
                    Width="24" Height="24"
                    Background="Transparent"
                    Cursor="Hand"
                    Visibility="Hidden">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 6,13 L 18,13" />
                    </Canvas>
                </Viewbox>
            </Border>
        </StackPanel>

        <!-- 单行歌词（需要翻译时是它下面的一小行） -->
        <StackPanel x:Name="ContentPanel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="16,0,16,4">

            <TextBlock x:Name="CurrentLine"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       Foreground="White"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Bold"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="CurrentLineOffset" X="0" Y="0" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TranslationLine"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#D8A8E6FF"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Normal"
                       Margin="0,2,0,0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- 临时状态文字：正在匹配歌词 / 未找到歌词 -->
        <TextBlock x:Name="StatusLine"
                   Grid.RowSpan="2"
                   TextAlignment="Center"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16,0"
                   Foreground="#C8FFFFFF"
                   FontFamily="Microsoft YaHei UI"
                   FontWeight="SemiBold"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
