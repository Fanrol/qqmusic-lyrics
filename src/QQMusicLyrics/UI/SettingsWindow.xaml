<Window x:Class="QQMusicLyrics.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="760" Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FocusVisualStyle="{x:Null}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 整窗只有一层黑色细边框；最小化/关闭键不描框，靠格子高亮表达可点 -->
    <Border BorderBrush="Black" BorderThickness="1" Background="#F1F1F1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <TextBlock Text="设置" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="#3A3A3A" FontSize="13" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="MinimizeButton" Width="38" Height="38"
                            Cursor="Hand" MouseLeftButtonDown="MinimizeButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#00FBFBFB" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FFFBFBFB" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00FBFBFB" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Data="M 0,0 L 11,0" Stroke="#3A3A3A" StrokeThickness="1.1"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="CloseButton" Width="38" Height="38"
                            Cursor="Hand" MouseLeftButtonDown="CloseButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#00FBFBFB" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FFFBFBFB" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00FBFBFB" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Data="M 0,0 L 11,11 M 11,0 L 0,11" Stroke="#3A3A3A" StrokeThickness="1.1"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 标题栏底部分隔线：放在按钮之后，才不会被悬停的白底盖住 -->
                <Border VerticalAlignment="Bottom" Height="1" Background="#DCDCDC" />
            </Grid>

            <!-- 左侧大类 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="152" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#E9E9E9"
                        BorderBrush="#DCDCDC" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="CategoryList" Margin="0,10,0,0">
                        <Border x:Name="ShortcutCategory" Height="36" Background="#F1F1F1" Cursor="Hand">
                            <TextBlock Text="快捷键" Margin="18,0,0,0" VerticalAlignment="Center"
                                       Foreground="#2F2F2F" />
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" Margin="24,20,24,20">
                        <TextBlock Text="快捷键" FontSize="15" Foreground="#2F2F2F" Margin="0,0,0,14" />

                        <!-- 一行快捷键：功能名顶左，方框顶右 -->
                        <Grid x:Name="ToggleHotkeyRow" Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="显示/隐藏" VerticalAlignment="Center" Foreground="#2F2F2F" />

                            <Border x:Name="HotkeyBox" Grid.Column="1"
                                    Width="190" Height="30"
                                    Background="White"
                                    BorderBrush="Black" BorderThickness="1"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    MouseLeftButtonDown="HotkeyBox_MouseLeftButtonDown">
                                <TextBlock x:Name="HotkeyText" Text="Alt + C"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#2F2F2F" />
                            </Border>
                        </Grid>


                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
