<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 目标框架让我们可以直接使用 WinRT 的 Windows.Media.Control（SMTC）投影 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>QQMusicLyrics</RootNamespace>
    <AssemblyName>QQMusicLyrics</AssemblyName>
    <Version>0.1.0</Version>
    <Product>QQ音乐浮窗歌词</Product>
    <AssemblyTitle>QQ音乐浮窗歌词</AssemblyTitle>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <!-- 管理员权限清单：没有它托盘图标在部分环境下注册不上 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 自身是 PerMonitorV2；这里显式声明一下，WinForms 部分（托盘菜单）也按此处理 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 便于出问题时看到完整异常信息 -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
